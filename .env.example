# 어드민 로그인 비밀번호 (필수)
ADMIN_PASSWORD=change-me
# 세션 쿠키 서명용 임의 문자열 (필수, 32자 이상 권장)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Docker: 서버에서 열 포트 (nginx proxy_pass와 맞춘다, 기본 3000)
# MOVEL_PORT=3000
# 콘텐츠 저장 위치 (Docker 없이 실행할 때만, 기본값 ./data. Docker는 항상 ./data 폴더)
# DATA_DIR=/var/lib/movel
# HTTPS 없이 테스트할 때만 false
# COOKIE_SECURE=false
